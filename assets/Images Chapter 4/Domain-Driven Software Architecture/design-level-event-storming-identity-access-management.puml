@startuml
title Identity and Access Management — Detailed Design-Level Event Storming
left to right direction
skinparam backgroundColor #F7FAFC
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #334E68
skinparam ArrowThickness 1.3
skinparam packageStyle rectangle
skinparam rectangle {
  RoundCorner 8
  Padding 8
}

rectangle "Administrator" as adminRegister #FFF3A6
rectangle "Administrator" as adminRole #FFF3A6
rectangle "Platform User" as userAuthenticate #FFF3A6
rectangle "Platform User" as userProfile #FFF3A6
rectangle "Platform User" as userFunctions #FFF3A6
rectangle "Platform User" as userProfileQuery #FFF3A6

package "Identity and Access Management · Generic Subdomain" #F1F5F9 {
  rectangle "Register User" as cmdRegister #A9C7F7
  rectangle "User" as aggRegister #FFE27A
  rectangle "User Registered" as evtRegistered #FFB26B

  rectangle "Assign Role" as cmdRole #A9C7F7
  rectangle "User" as aggRole #FFE27A
  rectangle "Role Assigned" as evtRole #FFB26B

  rectangle "Authenticate User" as cmdAuthenticate #A9C7F7
  rectangle "User" as aggAuthenticate #FFE27A
  rectangle "User Authenticated" as evtAuthenticated #FFB26B

  rectangle "Update User Profile" as cmdProfile #A9C7F7
  rectangle "User" as aggProfile #FFE27A
  rectangle "User Profile Updated" as evtProfile #FFB26B

  rectangle "Authorized Functions" as readFunctions #B9D98A
  rectangle "User Profile" as readProfile #B9D98A
}

adminRegister --> cmdRegister
cmdRegister --> aggRegister
aggRegister --> evtRegistered

adminRole --> cmdRole
cmdRole --> aggRole
aggRole --> evtRole

userAuthenticate --> cmdAuthenticate
cmdAuthenticate --> aggAuthenticate
aggAuthenticate --> evtAuthenticated

userProfile --> cmdProfile
cmdProfile --> aggProfile
aggProfile --> evtProfile

userFunctions ..> readFunctions : queries
userProfileQuery ..> readProfile : queries

adminRegister -[hidden]down-> adminRole
adminRole -[hidden]down-> userAuthenticate
userAuthenticate -[hidden]down-> userProfile
userProfile -[hidden]down-> userFunctions
userFunctions -[hidden]down-> userProfileQuery
cmdRegister -[hidden]down-> cmdRole
cmdRole -[hidden]down-> cmdAuthenticate
cmdAuthenticate -[hidden]down-> cmdProfile
cmdProfile -[hidden]down-> readFunctions
readFunctions -[hidden]down-> readProfile

note bottom of readFunctions
  Authorization and profile data are queried Read Models.
  They are not Policies because they issue no Command.
end note

legend bottom
|= Color |= EventStorming element |
|<#FFF3A6>| Actor |
|<#A9C7F7>| Command |
|<#FFE27A>| Aggregate Root |
|<#FFB26B>| Domain Event |
|<#B9D98A>| Read Model |
endlegend
@enduml
