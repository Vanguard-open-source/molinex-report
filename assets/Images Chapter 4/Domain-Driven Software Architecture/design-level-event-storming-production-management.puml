@startuml
title Production Management — Detailed Design-Level Event Storming
left to right direction
skinparam backgroundColor #F7FAFC
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #334E68
skinparam ArrowThickness 1.3
skinparam packageStyle rectangle
skinparam rectangle {
  RoundCorner 8
  Padding 8
}

rectangle "Production\nOperator" as operator #FFF3A6
rectangle "Administrator" as administrator #FFF3A6

package "Production Management · Core Subdomain" #E6F4EA {
  rectangle "Record Raw Material\nReception" as cmdReception #A9C7F7
  rectangle "RawMaterialReception" as aggReception #FFE27A
  rectangle "RawMaterialReception\nRecorded" as evtReception #FFB26B

  rectangle "Register Production\nBatch" as cmdBatch #A9C7F7
  rectangle "ProductionBatch" as aggBatch #FFE27A
  rectangle "ProductionBatch\nRegistered" as evtBatch #FFB26B

  rectangle "Record Production\nInformation" as cmdRecord #A9C7F7
  rectangle "ProductionRecord" as aggRecord #FFE27A
  rectangle "ProductionInformation\nRecorded" as evtRecorded #FFB26B

  rectangle "Update Production\nInformation" as cmdUpdate #A9C7F7
  rectangle "ProductionInformation\nUpdated" as evtUpdated #FFB26B

  rectangle "Production Processes" as readProcesses #B9D98A
  rectangle "Production History" as readHistory #B9D98A
}

operator --> cmdReception
cmdReception --> aggReception
aggReception --> evtReception

operator --> cmdBatch
cmdBatch --> aggBatch
aggBatch --> evtBatch

operator --> cmdRecord
cmdRecord --> aggRecord
aggRecord --> evtRecorded

operator --> cmdUpdate
cmdUpdate --> aggRecord
aggRecord --> evtUpdated

operator ..> readProcesses : queries
administrator ..> readHistory : queries

cmdReception -[hidden]down-> cmdBatch
cmdBatch -[hidden]down-> cmdRecord
cmdRecord -[hidden]down-> cmdUpdate
cmdUpdate -[hidden]down-> readProcesses
readProcesses -[hidden]right-> readHistory

note bottom of aggBatch
  The batch code is unique and the referenced
  reception must exist. Rejected commands do
  not change the aggregate or emit an event.
end note

legend bottom
|= Color |= EventStorming element |
|<#FFF3A6>| Actor |
|<#A9C7F7>| Command |
|<#FFE27A>| Aggregate Root |
|<#FFB26B>| Domain Event |
|<#B9D98A>| Read Model |
endlegend
@enduml
