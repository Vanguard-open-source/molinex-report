@startuml
skinparam backgroundColor #F7FAFC
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #334E68
skinparam ArrowThickness 1.4
skinparam RectangleBorderColor #486581
skinparam RectangleFontColor #102A43
skinparam rectangle {
  RoundCorner 12
  Padding 12
}

title Molinex - DDD Context Map
caption Strategic model relationships inside the modular monolith

top to bottom direction

rectangle "Production Management\n<<Core Subdomain>>" as production #D8F0DF
rectangle "Quality and Yield Control\n<<Core Subdomain>>" as quality #D8F0DF
rectangle "Operational Intelligence\n<<Core Subdomain>>" as intelligence #D8F0DF
rectangle "Asset and Maintenance Management\n<<Core Subdomain>>" as maintenance #D8F0DF

rectangle "Production-Quality Shared Kernel\nWeight · MeasurementUnit" as shared_kernel #FFE27A
rectangle "Commercial Engagement\n<<Supporting Subdomain>>" as commercial #E8EEF5
rectangle "Reporting and Analytics\n<<Supporting Subdomain / Read Side>>" as reporting #E8EEF5
rectangle "Identity and Access Management\n<<Generic Subdomain>>" as iam #E8EEF5

' Core collaboration: upstream to downstream.
production -[#2F6B9A]right-> quality
quality -[#2F6B9A]right-> intelligence
intelligence <-[#7A5195]right-> maintenance

' Deliberately small Shared Kernel owned only by Production and Quality.
production -[#C69214]down- shared_kernel
quality -[#C69214]down- shared_kernel

' IAM publishes one authorization contract to every consuming context.
iam -[#334E68]up-> production
iam -[#334E68]up-> quality
iam -[#334E68]up-> intelligence
iam -[#334E68]up-> maintenance
iam -[#334E68]up-> reporting

' Reporting consumes published events and builds independent projections.
production -[#2F6B9A]down-> reporting
quality -[#2F6B9A]down-> reporting
intelligence -[#2F6B9A]down-> reporting
maintenance -[#2F6B9A]down-> reporting

' Commercial onboarding is intentionally independent from IAM.
commercial .[#7B8794]down. iam

' Stable reading order: supporting/generic, core, shared/read side.
production -[hidden]right-> quality
quality -[hidden]right-> intelligence
intelligence -[hidden]right-> maintenance
shared_kernel -[hidden]right-> commercial
commercial -[hidden]right-> reporting
quality -[hidden]down-> shared_kernel
intelligence -[hidden]down-> reporting
reporting -[hidden]down-> iam

legend bottom
|= Color / notation |= Meaning |
|<#D8F0DF>| Core Subdomain |
|<#E8EEF5>| Supporting or Generic Subdomain |
|<#FFE27A>| Shared Kernel |
| Blue directed line | Customer/Supplier + Published Language |
| Dark directed line from IAM | Open Host Service / Published Language |
| Purple bidirectional line | Partnership + Published Language |
| Gold line | Shared Kernel |
| Gray dotted line | Separate Ways; no integration contract |
endlegend
@enduml
