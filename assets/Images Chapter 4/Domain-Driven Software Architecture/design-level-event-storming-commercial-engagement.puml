@startuml
title Commercial Engagement — Detailed Design-Level Event Storming
left to right direction
skinparam backgroundColor #F7FAFC
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #334E68
skinparam ArrowThickness 1.3
skinparam packageStyle rectangle
skinparam rectangle {
  RoundCorner 8
  Padding 8
}

rectangle "Visitor" as visitor #FFF3A6

package "Commercial Engagement · Supporting Subdomain" #F1F5F9 {
  rectangle "Submit Commercial\nInquiry" as cmdSubmit #A9C7F7
  rectangle "CommercialInquiry" as aggInquiry #FFE27A
  rectangle "CommercialInquiry\nSubmitted" as evtSubmitted #FFB26B

  rectangle "Plan Catalog" as readPlans #B9D98A
  rectangle "Value Proposition" as readValue #B9D98A
}

visitor --> cmdSubmit
cmdSubmit --> aggInquiry
aggInquiry --> evtSubmitted

visitor ..> readPlans : queries
visitor ..> readValue : queries

cmdSubmit -[hidden]down-> readPlans
readPlans -[hidden]right-> readValue

note bottom of aggInquiry
  Submission is initiated by the visitor. No Policy
  creates an account, subscription, or tenant.
end note

legend bottom
|= Color |= EventStorming element |
|<#FFF3A6>| Actor |
|<#A9C7F7>| Command |
|<#FFE27A>| Aggregate Root |
|<#FFB26B>| Domain Event |
|<#B9D98A>| Read Model |
endlegend
@enduml
