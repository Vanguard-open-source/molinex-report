  "components": {
    "schemas": {
      "UpdateProductionInformationResource": {
        "type": "object",
        "properties": {
          "batchId": {
            "type": "integer",
            "format": "int64"
          },
          "processName": {
            "type": "string"
          },
          "processedWeightValue": {
            "type": "number"
          },
          "processedWeightUnit": {
            "type": "string",
            "enum": [
              "KILOGRAM",
              "METRIC_TON"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "REGISTERED",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          }
        }
      },
      "RecordProductionWasteResource": {
        "type": "object",
        "properties": {
          "productionRecordId": {
            "type": "integer",
            "format": "int64"
          },
          "quantityValue": {
            "type": "number"
          },
          "quantityUnit": {
            "type": "string",
            "enum": [
              "KILOGRAM",
              "METRIC_TON"
            ]
          },
          "baseWeightValue": {
            "type": "number"
          },
          "baseWeightUnit": {
            "type": "string",
            "enum": [
              "KILOGRAM",
              "METRIC_TON"
            ]
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "productionRecordId",
          "quantityUnit",
          "quantityValue",
          "recordedAt"
        ]
      },
      "WasteRecordResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "productionRecordId": {
            "type": "integer",
            "format": "int64"
          },
          "quantityValue": {
            "type": "number"
          },
          "quantityUnit": {
            "type": "string",
            "enum": [
              "KILOGRAM",
              "METRIC_TON"
            ]
          },
          "baseWeightValue": {
            "type": "number"
          },
          "baseWeightUnit": {
            "type": "string",
            "enum": [
              "KILOGRAM",
              "METRIC_TON"
            ]
          },
          "percentage": {
            "type": "number"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuthenticateUserResource": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "AuthenticatedUserResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "RecordRawMaterialReceptionResource": {
        "type": "object",
        "properties": {
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "supplierName": {
            "type": "string"
          },
          "originDescription": {
            "type": "string"
          },
          "quantityValue": {
            "type": "number"
          },
          "quantityUnit": {
            "type": "string",
            "enum": [
              "KILOGRAM",
              "METRIC_TON"
            ]
          }
        }
      },
      "QualityMeasurementResource": {
        "type": "object",
        "properties": {
          "indicator": {
            "type": "string",
            "enum": [
              "WHOLE_GRAIN_PERCENTAGE",
              "BROKEN_GRAIN_PERCENTAGE",
              "YIELD_PERCENTAGE"
            ]
          },
          "value": {
            "type": "number"
          },
          "expectedMinimum": {
            "type": "number"
          },
          "expectedMaximum": {
            "type": "number"
          }
        },
        "required": [
          "expectedMaximum",
          "expectedMinimum",
          "indicator",
          "value"
