rectangle "Production Information\nUpdated" as e09 #FFB26B
rectangle "Quality Results\nRecorded" as e10 #FFB26B

rectangle "Production Waste\nRecorded" as e11 #FFB26B
rectangle "Yield Indicators\nCalculated" as e12 #FFB26B
rectangle "Rice Composition\nCalculated" as e13 #FFB26B
rectangle "Quality or Yield\nDeviation Identified" as e14 #FFB26B
rectangle "Machine\nRegistered" as e15 #FFB26B

