@startuml
skinparam backgroundColor #F7FAFC
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #334E68
skinparam ArrowThickness 1.5
skinparam RectangleBorderColor #486581
skinparam RectangleFontColor #102A43
skinparam PackageBorderColor #486581
skinparam PackageFontColor #102A43
skinparam package {
  BackgroundColor #EDF5FC
  RoundCorner 15
}
skinparam rectangle {
  RoundCorner 10
  Padding 10
}

title Step 4 - Pivotal Events and Candidate Business Areas
caption Pivotal events separate major stages of the business journey; commands, policies, aggregates, and read models are deferred to Design-Level EventStorming.

top to bottom direction

package "Commercial Engagement\nSupporting Subdomain" as bc_commercial #F1F5F9 {
  rectangle "Commercial Inquiry\nSubmitted" as ev_commercial #E88A3D
  rectangle "Subscription, payment, rice mill onboarding,\nand plan activation flow is missing" as hs_commercial #FF8A80
  ev_commercial ..> hs_commercial
}

package "Identity and Access Management\nGeneric Subdomain" as bc_iam #F1F5F9 {
  rectangle "User\nRegistered" as ev_user #FFB26B
  rectangle "Role\nAssigned" as ev_role #FFB26B
  rectangle "User\nAuthenticated" as ev_authenticated #E88A3D
  ev_user --> ev_role
  ev_role --> ev_authenticated
}

package "Production Management\nCore Subdomain" as bc_production #E6F4EA {
  rectangle "Raw Material Reception\nRecorded" as ev_reception #FFB26B
  rectangle "Raw Material Batch\nRegistered" as ev_batch #E88A3D
  rectangle "Production Information\nRecorded or Updated" as ev_production #E88A3D
  ev_reception --> ev_batch
  ev_batch --> ev_production
}

package "Quality and Yield Control\nCore Subdomain" as bc_quality #E6F4EA {
  rectangle "Quality Results\nRecorded" as ev_quality #FFB26B
  rectangle "Production Waste\nRecorded" as ev_waste #FFB26B
  rectangle "Yield Indicators\nCalculated" as ev_indicator #E88A3D
  rectangle "Quality or Yield\nDeviation Identified" as ev_deviation #E88A3D
  ev_quality --> ev_indicator
  ev_waste --> ev_indicator
  ev_indicator --> ev_deviation
}

package "Asset and Maintenance Management\nCore Subdomain" as bc_maintenance #E6F4EA {
  rectangle "Machine\nRegistered" as ev_machine #E88A3D
  rectangle "Maintenance\nRecorded" as ev_maintenance #E88A3D
  ev_machine --> ev_maintenance
}

package "Operational Intelligence\nCore Subdomain" as bc_intelligence #E6F4EA {
  rectangle "Operational Variable\nRecorded" as ev_variable #FFB26B
  rectangle "Operational Anomaly\nDetected" as ev_anomaly #E88A3D
  rectangle "Operational Alert\nGenerated" as ev_alert #FFB26B
  rectangle "Maintenance Recommendation\nGenerated" as ev_recommendation #FFB26B
  rectangle "Define the source, frequency, and ownership\nof operational variables" as hs_variable #FF8A80
  ev_variable --> ev_anomaly
  ev_anomaly --> ev_alert
  ev_anomaly --> ev_recommendation
  hs_variable ..> ev_variable
}

package "Reporting and Analytics\nSupporting Subdomain" as bc_reporting #F1F5F9 {
  rectangle "Production Report\nGenerated" as ev_production_report #E88A3D
  rectangle "Maintenance Report\nGenerated" as ev_maintenance_report #E88A3D
}

ev_production ..> ev_quality : enables quality control
ev_production ..> ev_production_report : contributes business facts
ev_indicator ..> ev_production_report : contributes indicators
ev_machine ..> ev_variable : identifies monitored machine
ev_anomaly ..> ev_maintenance : supports maintenance decision
ev_maintenance ..> ev_maintenance_report : contributes business facts

hs_commercial -[hidden]right-> ev_user
ev_user -[hidden]right-> ev_reception
ev_quality -[hidden]right-> ev_machine
ev_machine -[hidden]right-> ev_variable
ev_reception -[hidden]down-> ev_quality
ev_quality -[hidden]down-> ev_production_report
@enduml
