@startuml
skinparam backgroundColor #F7FAFC
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #334E68
skinparam RectangleBorderColor #486581
skinparam RectangleFontColor #102A43
skinparam rectangle {
  RoundCorner 12
  Padding 16
}

title Big Picture EventStorming Legend - Molinex

top to bottom direction

rectangle "Actor\nWho participates in the business flow?" as actor #FFF3A6
rectangle "Domain Event\nSignificant business fact expressed in past tense" as event #FFB26B
rectangle "Pivotal Event\nEvent that marks a relevant change in the journey" as pivotal #E88A3D
rectangle "External System\nSystem outside the Molinex boundary" as external #F5A3D7
rectangle "Hotspot\nQuestion, risk, or pending decision" as hotspot #FF8A80

actor -[hidden]right-> event
event -[hidden]right-> pivotal
pivotal -[hidden]right-> external
external -[hidden]right-> hotspot
@enduml
